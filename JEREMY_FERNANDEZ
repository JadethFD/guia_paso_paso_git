<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>JEREMY FERNANDEZ </title>
    <style>
        * {
            box-sizing: border-box;
           
        }

        body {
            font-family: Arial, sans-serif;
            
            background-image: url(https://i.pinimg.com/1200x/b7/84/2b/b7842b86f60f3cc3e11ae8f08d24466d.jpg);
            background-position: center;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .card {
            background-color: #bac4f3;
            padding: 30px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(65, 45, 14, 0.2);
            text-align: center;
            width: 320px;
        }
        h1 {
            color: #1e3d19;
            margin-bottom: 20px;
            font-size: 24px;
        }
        input[type="text"] {
            width: 100%;
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 5px;
            font-size: 14px;
            text-align: center;
            outline: none;
        }

        input[type="text"]:focus {
            border-color: #303480;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>¡Hola Mundo!</h1>
        <input type="text" placeholder="Escribe tu nombre aqui">
    </div>

</body>
</html>
